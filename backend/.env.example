# Runtime URL: use the Neon pooled hostname for application traffic.
DATABASE_URL="postgresql://USER:PASSWORD@YOUR-ENDPOINT-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&connect_timeout=15&pool_timeout=15&connection_limit=5"

# Migration URL: use the direct hostname, without `-pooler`.
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@YOUR-ENDPOINT.REGION.aws.neon.tech/DATABASE?sslmode=require&connect_timeout=15"

SESSION_SECRET="replace-with-at-least-32-random-characters"
CORS_ALLOWED_ORIGINS="http://localhost:8081"
